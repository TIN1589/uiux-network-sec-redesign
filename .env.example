# Runtime mode
ENV=development
DEMO_MODE=false
SHOW_BUILD_VERSION=false

# Persistent authentication
AUTH_DB_PATH=data/auth.sqlite3
# Required in production. Generate a unique random value; never commit the real secret.
AUTH_SECRET_KEY=
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_ABSOLUTE_SECONDS=28800
AUTH_SESSION_TOUCH_SECONDS=60
AUTH_CSRF_MAX_AGE_SECONDS=3600
AUTH_PBKDF2_ITERATIONS=600000

# Keep false for local HTTP/LAN testing; production HTTPS forces Secure cookies.
AUTH_COOKIE_SECURE=false
